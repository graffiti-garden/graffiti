{
  "name": "@graffiti-garden/streaming",
  "version": "0.0.0",
  "description": "Live audio and video over the Graffiti object and media API",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "main": "./dist/cjs/index.js",
  "browser": "./dist/browser/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Theia Henderson",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:performance": "vitest run --config vitest.performance.config.mts",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "build:js": "tsx esbuild.config.mts",
    "build": "rm -rf dist && npm run build:types && npm run build:js",
    "prepublishOnly": "npm test && npm run check",
    "demo": "npm run build && node demo/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graffiti-garden/graffiti.git",
    "directory": "extras/streaming"
  },
  "bugs": {
    "url": "https://github.com/graffiti-garden/graffiti/issues"
  },
  "dependencies": {
    "@kixelated/libavjs-webcodecs-polyfill": "0.5.6",
    "@libav.js/variant-opus-af": "6.11.9",
    "@moq/net": "0.4.8",
    "@moq/publish": "0.5.6",
    "@moq/signals": "0.2.6",
    "@moq/watch": "0.6.6"
  },
  "peerDependencies": {
    "@graffiti-garden/api": "^1.6.0"
  },
  "devDependencies": {
    "@graffiti-garden/api": "^1.6.0",
    "@graffiti-garden/implementation-local": "^1.6.0",
    "@graffiti-garden/implementation-decentralized": "^0.6.1",
    "@ipld/dag-cbor": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "^4.0.17",
    "esbuild": "^0.28.2",
    "playwright": "1.62.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  }
}
