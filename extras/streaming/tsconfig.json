{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
