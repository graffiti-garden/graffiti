{
  "name": "graffiti",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "api",
    "wrappers/runtime-types",
    "wrappers/utils/modal",
    "implementations/local",
    "implementations/decentralized/client",
    "wrappers/synchronize",
    "wrappers/iframe-rpc",
    "plugins/vue",
    "wrappers/data-guard/client",
    "wrappers/data-guard/host",
    "wrappers/data-guard/example",
    "implementations/decentralized/server",
    "examples/glitter",
    "examples/parallax",
    "examples/wikiffiti"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run build && npm run check && npm test"
  },
  "overrides": {
    "undici": "7.29.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "rollup": "4.63.1"
  }
}
