{
  "name": "graffiti",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1",
      "onFail": "error"
    }
  },
  "workspaces": [
    "api",
    "wrappers/runtime-types",
    "wrappers/utils/modal",
    "implementations/local",
    "implementations/decentralized/client",
    "wrappers/synchronize",
    "wrappers/iframe-rpc",
    "plugins/vue",
    "wrappers/data-guard/client",
    "wrappers/data-guard/host",
    "wrappers/data-guard/example",
    "implementations/decentralized/server",
    "examples/glitter",
    "examples/parallax",
    "examples/wikiffiti"
  ],
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run build && npm run check && npm test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  }
}
