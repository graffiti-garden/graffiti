{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "declarationDir": "./dist",
  },
  "include": ["src"],
}
